{
	"name": "pedalcms",
	"version": "0.3.0",
	"description": "PedalCMS Core Plugin",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PedalCMS/pedalcms.git"
	},
	"keywords": [],
	"author": "PedalCMS",
	"license": "GPLv2",
	"bugs": {
		"url": "https://github.com/PedalCMS/pedalcms/issues"
	},
	"homepage": "https://github.com/PedalCMS/pedalcms#readme",
	"devDependencies": {
		"@babel/cli": "^7.16.8",
		"@babel/core": "^7.16.12",
		"@babel/preset-env": "^7.16.11",
		"@wordpress/eslint-plugin": "^24.5.0",
		"autoprefixer": "^10.4.2",
		"eslint": "^8.7.0",
		"postcss": "^8.4.6",
		"postcss-cli": "^9.1.0",
		"prettier": "^3.8.1",
		"sass": "^1.49.7",
		"@playwright/test": "^1.50.1",
		"@wordpress/env": "^10.18.0",
		"dotenv": "^16.4.7"
	},
	"prettier": {
		"semi": true,
		"tabWidth": 2,
		"singleQuote": true,
		"overrides": [
			{
				"files": [
					"*.html"
				],
				"options": {
					"tabWidth": 4,
					"singleQuote": false
				}
			}
		]
	},
	"babel": {
		"presets": [
			"@babel/preset-env"
		],
		"plugins": []
	},
	"eslintConfig": {
		"env": {
			"browser": true,
			"es2021": true
		},
		"extends": [
			"plugin:@wordpress/eslint-plugin/recommended"
		],
		"parserOptions": {
			"ecmaVersion": "latest",
			"sourceType": "module"
		},
		"rules": {}
	},
	"scripts": {
		"wp-env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:clean": "wp-env clean",
		"env:destroy": "wp-env destroy"
	}
}
