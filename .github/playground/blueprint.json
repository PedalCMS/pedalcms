			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; update_option('options_pdl_program_url_apply_now', site_url('/program-actions/')); update_option('options_pdl_program_url_contact', site_url('/program-actions/'));"
		},
		{
			"step": "runPHP",
			"code": {
				"file": "astra-settings.php"
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "url",
				"url": "https://demo-content.pedalcms.com/demo-content.xml"
			},
			"fetchAttachments": true,
			"rewriteUrls": true,
			"authorsMode": "default-author",
			"defaultAuthorUsername": "admin"
		},
		{
			"step": "runPHP",
			"code": "<?php\nrequire_once '/wordpress/wp-load.php';\n\n$home = get_page_by_path( 'home', OBJECT, 'page' );\n\nif ( ! $home instanceof WP_Post ) {\n\tthrow new RuntimeException( 'The imported Home page could not be found.' );\n}\n\nupdate_option( 'show_on_front', 'page' );\nupdate_option( 'page_on_front', (int) $home->ID );\n"
		},
		{
			"step": "runPHPWithOptions",
			"options": {
				"code": "<?php\nrequire_once '/wordpress/wp-load.php';\n\n$menu_name = 'Main Menu';\n\n// Ensure the menu exists.\n$menu_term = get_term_by('name', $menu_name, 'nav_menu');\nif (!$menu_term || is_wp_error($menu_term)) {\n  $menu_id = wp_create_nav_menu($menu_name);\n} else {\n  $menu_id = (int) $menu_term->term_id;\n}\n\n// Load existing assignments and update the primary location.\n$locations = get_theme_mod('nav_menu_locations');\nif (!is_array($locations)) { $locations = []; }\n\n$locations['primary'] = $menu_id;\nset_theme_mod('nav_menu_locations', $locations);\n?>",
				"body": "Assign Astra primary menu"
			}
		}
