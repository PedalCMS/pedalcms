<?xml version="1.0" encoding="UTF-8" ?>
<phpdocumentor
        configVersion="3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://www.phpdoc.org"
        xsi:noNamespaceSchemaLocation="https://docs.phpdoc.org/latest/phpdoc.xsd"
>
    <title>PedalCMS Developer Docs</title>
    <paths>
        <output>docs</output>
    </paths>
    <version number="3.0.0">
        <api>
            <source dsn=".">
                <path>/</path>
            </source>
            <ignore>
                <path>/vendor/</path>
                <path>/tests/</path>
                <path>/node_modules/</path>
                <path>**/index.php</path>
            </ignore>
            <default-package-name>PedalCMS\Core</default-package-name>
        </api>
    </version>
    <!-- <setting name="graphs.enabled" value="true"/> -->
    <setting name="template.color" value="light-blue"/>
    <setting name="guides.enabled" value="true"/>
</phpdocumentor>
